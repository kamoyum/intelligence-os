# Optional OpenAI reasoning/evaluation. Leave blank for Mock + heuristic modes.
OPENAI_API_KEY=
INTELLIGENCE_MODEL=
INTELLIGENCE_EVAL_MODEL=
# Optional semantic reranking. If blank, FTS5 retrieval is used without embeddings.
INTELLIGENCE_EMBEDDING_MODEL=
# External LLM privacy: off | opt_in | all. opt_in is recommended.
INTELLIGENCE_EXTERNAL_LLM_MODE=opt_in
# Hard ceiling on embedding API input items per UTC day (query + new memories).
INTELLIGENCE_EMBEDDING_DAILY_INPUTS=100

# Google connector: off | safe | personal_full
# safe: Calendar read-only + narrow Drive file scope; no Gmail.
# personal_full: Calendar read-only + Drive read-only + Gmail read-only.
# personal_full uses restricted Google scopes and is for private testing unless verification requirements are met.
INTELLIGENCE_GOOGLE_MODE=off
GOOGLE_CLIENT_SECRET_FILE=./google_client_secret.json
INTELLIGENCE_CORE_ORIGIN=http://127.0.0.1:8765

# Optional verifier model. If unset, Eval/Reasoning model is reused; without API key local heuristic verification is used.
INTELLIGENCE_VERIFY_MODEL=

# Current-source research (optional; uses OpenAI Responses API web search)
INTELLIGENCE_RESEARCH_MODEL=
INTELLIGENCE_RESEARCH_MODE=auto_public
INTELLIGENCE_WEB_SEARCH_DAILY_QUERIES=10
INTELLIGENCE_RESEARCH_MAX_SOURCES=6
INTELLIGENCE_RESEARCH_TIMEOUT_SECONDS=20
INTELLIGENCE_RESEARCH_MAX_BYTES=2500000
